---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import '../styles/global.css';

const partners = [
  { href: 'https://discord.gg/CUUwVAVveD', img: '/partners/bods.png', name: 'Biology Olympiad Discord Server' },
  { href: 'https://www.sciovirtual.org/', img: '/partners/sciovirtual.png', name: 'ScioVirtual' },
  { href: 'https://pandorax.org/', img: '/partners/pandorax.png', name: 'PandoraX' },
];
---

<Layout title="Partners - Mitosisphere">
  <div class="border-b border-gray-700" style="background-color: var(--color-bg);">
    <Container class="text-center pt-24 pb-16 md:pt-32 md:pb-20">
      <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight text-gray-50">
        Partners
      </h1>
      <p class="text-lg md:text-xl max-w-3xl mx-auto text-gray-400 mt-6">
        A special thank you to all of our partners, who have helped us impact a wider audience!
      </p>
    </Container>
  </div>

  <main>
    <section class="py-16 md:py-24" style="background-color: var(--color-card-bg);">
      <Container>
        <div class="flex flex-col items-center gap-16 md:gap-24 max-w-3xl mx-auto">
          {partners.map(partner => (
            <a href={partner.href} target="_blank" rel="noopener">
              <img class="w-[600px] max-w-full" src={partner.img} alt={`${partner.name} logo`} />
            </a>
          ))}
        </div>
      </Container>
    </section>
  </main>
</Layout>
