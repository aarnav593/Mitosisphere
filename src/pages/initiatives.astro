---
import Layout from "@layouts/Layout.astro";
import Link from "@components/ui/link.astro";
import { Icon } from "astro-icon/components";
import Container from "@components/container.astro";
import '../styles/global.css';

---

<Layout title="Mitosisphere - Initiatives">
  <div class="border-b border-gray-700" style="background-color: var(--color-bg);">
    <Container class="text-center pt-24 pb-16 md:pt-32 md:pb-20">
      <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight text-gray-50">
        Our Initiatives
      </h1>
      <p class="text-lg md:text-xl max-w-3xl mx-auto text-gray-400 mt-6">
        Comprehensive resources designed to power your biology journey, from competitions to mentorship.
      </p>
    </Container>
  </div>

  <main>
    <section class="py-16 md:py-24" style="background-color: var(--color-card-bg);">
      <Container>
        <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">

          <!-- Lamnahj -->
          <div class="card p-8">
            <div class="flex items-center gap-3 mb-3">
              <Icon name="uil:book-open" class="w-8 h-8 flex-shrink-0" style="color: var(--color-logo-purple);" />
              <h3 class="text-2xl font-bold text-gray-100">Lamnhaj's Guide to USABO</h3>
            </div>
            <p class="text-gray-400 leading-relaxed">
              A USABO Finalist-reviewed 200-page textbook with detailed topic guides and strategies for approaching the USABO. Included are nearly 300 practice problems, 2 full-length practice exams with solutions, exam pacing strategies, and more!
            </p>
            <div class="mt-6">
              <Link
                href="https://guide.mitosisphere.org"
                target="_blank"
                rel="noopener"
                class:list={["inline-flex items-center justify-center px-6 py-3 text-sm font-semibold rounded-lg hero-button"]}>
                Open Lamnhaj &rarr;
              </Link>
            </div>
          </div>

          <!-- Competitions -->
          <div class="card p-8">
            <div class="flex items-center gap-3 mb-3">
              <Icon name="uil:trophy" class="w-8 h-8 flex-shrink-0" style="color: var(--color-logo-blue);" />
              <h3 class="text-2xl font-bold text-gray-100">Competitions</h3>
            </div>
            <p class="text-gray-400 leading-relaxed">
              Challenge yourself with our comprehensive competition suite: the p + q series (Opens &amp; Semifinals mirroring USABO difficulty), Mitosisphere BioBowl (Science Bowl format), and Monthly Challenges for continuous practice throughout the year.
            </p>
            <div class="mt-6">
              <Link
                href="/competitions"
                class:list={["inline-flex items-center justify-center px-6 py-3 text-sm font-semibold rounded-lg hero-button"]}>
                Learn More &rarr;
              </Link>
            </div>
          </div>

          <!-- Monthly Challenges -->
          <div class="card p-8">
            <div class="flex items-center gap-3 mb-3">
              <Icon name="uil:calendar-alt" class="w-8 h-8 flex-shrink-0" style="color: var(--color-logo-purple);" />
              <h3 class="text-2xl font-bold text-gray-100">Monthly Challenges</h3>
            </div>
            <p class="text-gray-400 leading-relaxed">
              Stay sharp year-round! New question sets released every month with varied difficulty levels, community discussions, and detailed solutions to keep your skills fresh between competition seasons.
            </p>
            <div class="mt-6">
              <Link
                href="https://discord.com/invite/Sq3nTXyS6D"
                target="_blank"
                rel="noopener"
                class:list={["inline-flex items-center justify-center px-6 py-3 text-sm font-semibold rounded-lg hero-button"]}>
                Join Discord &rarr;
              </Link>
            </div>
          </div>

          <!-- Mentorship Program -->
          <div class="card p-8">
            <div class="flex items-center gap-3 mb-3">
              <Icon name="uil:users-alt" class="w-8 h-8 flex-shrink-0" style="color: var(--color-logo-blue);" />
              <h3 class="text-2xl font-bold text-gray-100">Mentorship Program</h3>
            </div>
            <p class="text-gray-400 leading-relaxed">
              Free personalized coaching from IBO medalists and ISEF finalists. Get expert guidance on USABO preparation, research competitions, internship applications, and more.
            </p>
            <div class="mt-6">
              <Link
                href="https://docs.google.com/forms/d/e/1FAIpQLSeNus46S6bVyhOg34M5q6AKYT6MIoIsTjNDT9EixfXXbRxBCw/viewform"
                target="_blank"
                rel="noopener"
                class:list={["inline-flex items-center justify-center px-6 py-3 text-sm font-semibold rounded-lg hero-button"]}>
                Apply Now &rarr;
              </Link>
            </div>
          </div>

        </div>
      </Container>
    </section>
  </main>
</Layout>
