---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import '../styles/global.css';

const textbooks = [
  {
    title: "Campbell's Biology",
    img: '/textbooks/campbell.png',
    desc: "Campbell's Biology is the essential textbook for those beginning their journey in biology competitions. It presents foundational concepts in a clear, engaging, and accessible manner!"
  },
  {
    title: "Vander's Human Physiology",
    img: '/textbooks/vander.png',
    desc: "Vander's Human Physiology is an excellent textbook for anyone seeking to deepen their knowledge in anatomy and physiology. It's comprehensive, concise, and has detailed and understandable explanations."
  },
  {
    title: "Raven's Biology of Plants",
    img: '/textbooks/raven.png',
    desc: "Raven's Biology of Plants is the book when it comes to plants, covering all the painstaking details of plant physiology, taxonomy, evolution, and morphology."
  },
  {
    title: "Brooker's Genetics - Analysis & Principles",
    img: '/textbooks/brooker.png',
    desc: "Brooker's Genetics is an amazing way to improve genetics skills, covering critical genetics concepts and the relevant molecular biology in addition to helping students with genetics problem-solving skills."
  },
  {
    title: "Albert's Molecular Biology of the Cell",
    img: '/textbooks/alberts.png',
    desc: "Albert's Molecular Biology of the Cell is the one and only molecular biology textbook when it comes to success in competition biology, covering almost everything there is to know about the topic."
  },
  {
    title: "Lehninger's Principles of Biochemistry",
    img: '/textbooks/lehninger.png',
    desc: "Lehninger's Principles of Biochemistry is a fantastic exposition in biochemistry. The detailed reaction schemes and structures in the book help build intuition for biochemical problems."
  },
];
---

<Layout title="Resources - Mitosisphere">
  <script is:inline id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

  <div class="border-b border-gray-700" style="background-color: var(--color-bg);">
    <Container class="text-center pt-24 pb-16 md:pt-32 md:pb-20">
      <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight text-gray-50">
        Resources
      </h1>
      <p class="text-lg md:text-xl max-w-3xl mx-auto text-gray-400 mt-6">
        A collection of useful resources, intended to assist with biology as a whole in addition to our competitions.
      </p>
    </Container>
  </div>

  <main>
    <section class="py-16 md:py-24" style="background-color: var(--color-card-bg);">
      <Container>
        <div class="text-center">
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-50">Sample Tests</h2>
        </div>
        <div class="mt-8 text-lg md:text-xl leading-loose max-w-3xl mx-auto text-center">
          <a href="/practice-test.pdf" class="text-blue-400 hover:text-blue-300 transition-colors">\(p+q=1\) Practice Exam</a><br>
          <a href="/practice-answers.pdf" class="text-blue-400 hover:text-blue-300 transition-colors">\(p+q=1\) Practice Exam Answers</a>
        </div>
      </Container>
    </section>

    <section class="py-16 md:py-24 border-t border-gray-700" style="background-color: var(--color-bg);">
      <Container>
        <div class="text-center">
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-50">Textbooks</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-y-16 md:gap-16 mx-auto max-w-4xl mt-12">
          {textbooks.map(book => (
            <div class="text-center">
              <img
                src={book.img}
                alt={`Cover of ${book.title}`}
                class="h-[329px] w-[272px] mx-auto rounded-lg mb-8 transition hover:-translate-y-1 hover:shadow-xl hover:shadow-black/40"
              />
              <p class="font-bold text-xl mb-2 text-gray-100">{book.title}</p>
              <p class="text-gray-400">{book.desc}</p>
            </div>
          ))}
        </div>
      </Container>
    </section>
  </main>
</Layout>
