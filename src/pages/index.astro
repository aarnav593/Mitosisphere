---
import Layout from "@layouts/Layout.astro";
import Link from "@components/ui/link.astro";
import { Icon } from "astro-icon/components";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import '../styles/global.css';

const testimonials = [
  {
    name: 'Ajay Sawant',
    title: '2026 USABO Finalist',
    quote: "Mitosisphere introduced me to a warm and welcoming biology community that really helped to cultivate my love and appreciation for the biological world. I first learned about Mitosisphere through the monthly challenges, which helped me to prepare for the USABO Open and Semifinal exams by introducing me to a plethora of topics with the necessary depth to appreciate and understand them. Lamnhaj's Guide to USABO also helps greatly with this; it not only provides practice questions like the monthly challenges, but also provides a structured curriculum on all the topics. Additionally, the staff and community have an infectious passion for biology, which helped me to connect with the content on a deeper level."
  },
  {
    name: 'Theenash Sengupta',
    title: '2026 USABO Finalist',
    quote: "Combining creative question writers, a polished training platform, and airtight competition schedules, Mitosisphere is an organization like few others. Each one of their problems helped me see biology from a new angle, elegantly integrating concepts from every corner of the textbook canon and helping build confidence in problem-solving. I strongly recommend checking out their long list of resources for anyone interested in beginning a journey in competitive biology!"
  },
];
---

<Layout title="Mitosisphere: Multiplying Success, One Division at a Time">
  <style>
    .join-team-section {
      background-color: #1E1B4B;
    }
    .join-team-section h2,
    .join-team-section p {
      color: white;
    }
    .join-team-section .link-primary {
      background-color: white;
      color: #1E1B4B;
      font-weight: 700;
      box-shadow: 0 4px 14px 0 rgba(0,0,0,0.2);
    }
    .join-team-section .link-primary:hover {
       background-color: #E0E7FF;
    }
  </style>

  <div style="background-color: var(--color-bg);">
    <Container class="text-center pt-16 pb-16 md:pt-24 md:pb-20">
      <img src="/logo.png" alt="Mitosisphere Logo" class="mx-auto w-40 h-40 md:w-52 md:h-52 mb-8" />
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight leading-tight text-gray-50">
        Advanced Biology Made <span style="color: var(--color-logo-text);">Accessible</span>.
      </h1>
      <p class="text-lg md:text-xl max-w-3xl mx-auto text-gray-400 mt-6">
        Mitosisphere provides expert-designed resources for competitive biology.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <Link
          href="/initiatives"
          class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold rounded-lg shadow-sm hero-button"
        >
          Explore Resources
        </Link>
        <Link
          href="/competitions"
          class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold rounded-lg shadow-sm hero-secondary-button"
        >
          View Competitions
        </Link>
      </div>
    </Container>
  </div>

  <main>
    <section class="pb-16 md:pb-24" style="background-color: var(--color-bg);">
      <Container>
        <div class="featured-card p-8 md:p-12 max-w-5xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-50">Fall p+q=1 Opens Exam</h2>
          <p class="text-sm font-semibold tracking-wider mt-3" style="color: var(--color-logo-blue);">
            Registration open now!
          </p>
          <p class="text-lg text-gray-400 mt-4 max-w-2xl mx-auto">
            Take our 50-question multiple-choice exam, similar in difficulty and structure to the
            USABO Open Exam, any time between November 9 and November 15. $100 in prizes and certificates for the top performers!
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
            <Link
              href="https://docs.google.com/forms/d/e/1FAIpQLSetbdLgR3eB0EG0fiTJzloQZis1Ut9xbWlVj7_A7OduvmvKrw/viewform"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold rounded-lg shadow-sm hero-button"
            >
              Register Now
            </Link>
            <Link
              href="/rules.pdf"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold rounded-lg shadow-sm hero-secondary-button"
            >
              <Icon name="uil:file-alt" class="w-5 h-5 mr-2" />
              Read the Rules
            </Link>
          </div>
        </div>
      </Container>
    </section>

    <section class="py-16 md:py-24 border-y border-gray-700" style="background-color: var(--color-card-bg);">
      <Container>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 text-center max-w-4xl mx-auto">
          <div>
            <p class="text-5xl font-extrabold" style="color: var(--color-logo-blue);">1500+</p>
            <p class="text-gray-300 mt-3 text-lg">Exam Competitors from 19 Countries</p>
          </div>
          <div>
            <p class="text-5xl font-extrabold" style="color: var(--color-logo-purple);">700+</p>
            <p class="text-gray-300 mt-3 text-lg">Active Discord Community Members</p>
          </div>
        </div>
      </Container>
    </section>

    <section id="testimonials" class="py-16 md:py-24" style="background-color: var(--color-bg);">
      <Container>
        <Sectionhead>
          <Fragment slot="title">Testimonials</Fragment>
          <Fragment slot="desc">Hear from the <span style="color: var(--color-logo-purple);">students</span> who have been part of our community.</Fragment>
        </Sectionhead>
        <div class="grid grid-cols-1 md:grid-cols-2 items-start gap-8 mt-12 max-w-6xl mx-auto">
          {testimonials.map(testimonial => (
            <figure class="card p-8 md:p-10">
              <blockquote class="text-gray-300 leading-relaxed text-lg">
                &ldquo;{testimonial.quote}&rdquo;
              </blockquote>
              <figcaption class="mt-6 font-semibold" style="color: var(--color-logo-text);">
                &mdash; {testimonial.name}, <span class="text-gray-400 font-medium">{testimonial.title}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </Container>
    </section>

    <section class="join-team-section py-16 md:py-24">
      <Container class="text-center max-w-4xl mx-auto">
        <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight">Join Our Team</h2>
        <p class="text-lg md:text-xl mt-6 opacity-90">
          Interested in our mission? Apply today. We are especially looking to expand our outreach team!
        </p>
        <div class="mt-10 flex flex-col md:flex-row gap-4 justify-center">
            <Link
              href="https://forms.gle/jePabrYs13KvFSqt9"
              target="_blank"
              class:list={["link-primary inline-flex items-center justify-center px-8 py-4 text-base font-semibold rounded-lg shadow-sm"]}
              rel="noopener"
            >
              <Icon name="uil:file-alt" class="w-5 h-5 mr-2" />
              Staff Application
            </Link>
            <Link
              href="https://discord.com/invite/Sq3nTXyS6D"
              target="_blank"
              class:list={["link-primary inline-flex items-center justify-center px-8 py-4 text-base font-semibold rounded-lg shadow-sm !bg-white/10 !text-white hover:!bg-white/20"]}
              rel="noopener"
            >
              <Icon name="simple-icons:discord" class="w-5 h-5 mr-2" />
              Join Our Discord
            </Link>
          </div>
      </Container>
    </section>
  </main>
</Layout>
