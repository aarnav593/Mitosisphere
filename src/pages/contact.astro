---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import { Icon } from "astro-icon/components";
import '../styles/global.css';
---

<Layout title="Contact - Mitosisphere">
  <style>
    .email-link {
      color: var(--color-logo-text);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s ease;
    }

    .email-link:hover {
      color: #8B8BED;
    }
  </style>

  <div class="border-b border-gray-700" style="background-color: var(--color-bg);">
    <Container class="text-center pt-24 pb-16 md:pt-32 md:pb-20">
      <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight text-gray-50">
        Contact Us
      </h1>
      <p class="text-lg md:text-xl max-w-2xl mx-auto text-gray-400 mt-6">
        Have a question or want to get in touch? Reach out to the right team below.
      </p>
    </Container>
  </div>

  <main>
    <section class="py-16 md:py-24" style="background-color: var(--color-card-bg);">
      <Container>
        <div class="max-w-xl mx-auto space-y-8">

          <div class="card p-8">
            <Icon name="uil:envelope" class="w-8 h-8 mb-5" style="color: var(--color-logo-blue);" />
            <h3 class="text-xl font-bold text-gray-100 mb-2">General Inquiries &amp; Partnerships</h3>
            <p class="text-gray-400 leading-relaxed mb-6">
              For general questions, collaboration opportunities, or partnership requests, reach out to our main team.
            </p>
            <a href="mailto:mitosisphere@gmail.com" class="email-link">
              mitosisphere@gmail.com
            </a>
          </div>

          <div class="card p-8">
            <div class="mb-5">
              <span class="text-3xl">🛠️</span>
            </div>
            <h3 class="text-xl font-bold text-gray-100 mb-2">Technical Problems & Other Concerns</h3>
            <p class="text-gray-400 leading-relaxed mb-6">
              For website issues, technical bugs, or any other concerns not covered above, contact our technical team.
            </p>
            <a href="mailto:aarnavsuwal@gmail.com" class="email-link">
              aarnavsuwal@gmail.com
            </a>
          </div>

        </div>
      </Container>
    </section>
  </main>
</Layout>
