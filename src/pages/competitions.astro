---
import Layout from "@layouts/Layout.astro";
import Link from "@components/ui/link.astro";
import { Icon } from "astro-icon/components";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import '../styles/global.css';

---

<Layout title="Mitosisphere - Competitions">
  <script is:inline id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

  <div class="border-b border-gray-700" style="background-color: var(--color-bg);">
    <Container class="text-center pt-24 pb-16 md:pt-32 md:pb-20">
      <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight text-gray-50">
        Our Competitions
      </h1>
      <p class="text-lg md:text-xl max-w-3xl mx-auto text-gray-400 mt-6">
        We run two annual competitions analogous to the USABO Open and Semifinal exams, and registration for our Fall p+q=1 Opens Exam is open now.
      </p>
    </Container>
  </div>

  <main>
    <section class="py-16 md:py-24" style="background-color: var(--color-card-bg);">
      <Container>
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-50">
            Fall p+q=1 Opens Exam
          </h2>
          <p class="text-sm font-semibold tracking-wider mt-3" style="color: var(--color-logo-blue);">
            Registration open now!
          </p>
          <p class="mt-4 text-lg text-gray-400 leading-relaxed max-w-2xl mx-auto">
            A 50-question multiple-choice exam, similar in difficulty and structure to the USABO Open
            Exam. The testing window runs from Sunday, November 9 at 12 AM PST to Saturday,
            November 15 at 11:59 PM PST. $100 in prizes and certificates for the top performers!
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-10 max-w-2xl mx-auto">
            <div class="card p-6 text-center">
              <Icon name="uil:file-question-alt" class="w-8 h-8 mx-auto mb-3" style="color: var(--color-logo-blue);" />
              <p class="text-2xl font-extrabold text-gray-50">50 MCQs</p>
              <p class="text-gray-400 mt-1 text-sm">USABO Open format</p>
            </div>
            <div class="card p-6 text-center">
              <Icon name="uil:calendar-alt" class="w-8 h-8 mx-auto mb-3" style="color: var(--color-logo-purple);" />
              <p class="text-2xl font-extrabold text-gray-50">Nov 9–15</p>
              <p class="text-gray-400 mt-1 text-sm">Testing window (PST)</p>
            </div>
          </div>

          <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
            <Link
              href="https://docs.google.com/forms/d/e/1FAIpQLSetbdLgR3eB0EG0fiTJzloQZis1Ut9xbWlVj7_A7OduvmvKrw/viewform"
              target="_blank"
              class:list={["inline-flex items-center justify-center px-8 py-4 text-base font-semibold rounded-lg shadow-sm hero-button"]}
              rel="noopener">
              Register Now
            </Link>
            <Link
              href="/rules.pdf"
              target="_blank"
              class:list={["inline-flex items-center justify-center px-8 py-4 text-base font-semibold rounded-lg shadow-sm hero-secondary-button"]}
              rel="noopener">
              <Icon name="uil:file-alt" class="w-5 h-5 mr-2" />
              Read the Rules
            </Link>
          </div>
        </div>
      </Container>
    </section>

    <section class="py-16 md:py-24 border-t border-gray-700" style="background-color: var(--color-bg);">
      <Container>
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-50">
            Rules &amp; Information
          </h2>
          <p class="mt-6 text-lg text-gray-400 leading-relaxed">
            Open to high school students globally, our exams will take place online. They will be available to take all day. Explore the complete guidelines in our official rules document!
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
             <Link
              href="https://forms.gle/7oaq31kiAhSstxwY6"
              target="_blank"
              class:list={["inline-flex items-center justify-center px-8 py-4 text-base font-semibold rounded-lg shadow-sm hero-button"]}
              rel="noopener">
              Sign Up for Updates
            </Link>
            <Link
              href="/rules.pdf"
              target="_blank"
              class:list={["inline-flex items-center justify-center px-8 py-4 text-base font-semibold rounded-lg shadow-sm !bg-gray-700 !text-gray-200 border !border-gray-600 hover:!bg-gray-600 hover:!border-gray-500 transition-colors"]}
              rel="noopener">
              Read the Rules
            </Link>
          </div>
        </div>
      </Container>
    </section>

    <section class="py-16 md:py-24 border-t border-gray-700" style="background-color: var(--color-card-bg);">
      <Container>
        <Sectionhead>
          <Fragment slot="title">Competition Rounds</Fragment>
          <Fragment slot="desc">Our two-round system is designed to challenge and prepare students for national-level biology competitions.</Fragment>
        </Sectionhead>

        <div class="mt-12 grid md:grid-cols-2 gap-8 max-w-6xl mx-auto">
          <div class="card p-8 text-left">
            <div class="flex items-center gap-4 mb-4">
              <Icon name="uil:file-alt" class="w-8 h-8 flex-shrink-0" style="color: var(--color-logo-blue);" />
              <h3 class="text-2xl md:text-3xl font-bold text-gray-100">
                \(p+q = 1\)
              </h3>
            </div>
            <p class="text-gray-400 leading-relaxed">
              This is the first round of our competition, mirroring the difficulty of the USABO Open exam. The test consists of 50 multiple-choice questions to be completed in 50 minutes, with 5 choices per question.
            </p>
          </div>

          <div class="card p-8 text-left">
            <div class="flex items-center gap-4 mb-4">
              <Icon name="uil:file-check-alt" class="w-8 h-8 flex-shrink-0" style="color: var(--color-logo-purple);" />
              <h3 class="text-2xl md:text-3xl font-bold text-gray-100">
                \((p+q)^2=1\)
              </h3>
            </div>
            <p class="text-gray-400 leading-relaxed">
              This second round corresponds to the USABO Semifinals exam. The test consists of 100 questions in 120 minutes, featuring 65 multiple-choice and 35 multiple-true/false questions.
            </p>
          </div>
        </div>
      </Container>
    </section>
  </main>
</Layout>
